# Copy this file to .env and fill in your Alpaca PAPER account credentials locally.
# Never commit .env or share API secret values in chat.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Explicitly enable manual broker paper orders after checking your credentials.
ALPACA_PAPER_ORDERS=false
HOST=127.0.0.1
PORT=3000
# Pair research uses Alpaca daily prices + news. keyword needs no additional key.
PAIR_NLP_PROVIDER=keyword
# Optional semantic news analysis through OpenAI; this can incur API charges.
# Set PAIR_NLP_PROVIDER=semantic and add your own server-side API key to enable.
NLP_API_KEY=
NLP_MODEL=gpt-4.1-mini
